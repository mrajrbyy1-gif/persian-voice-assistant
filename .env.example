# نمونه فایل تنظیمات - Secrets را اینجا قرار ندهید
# این فایل برای نمونه است. مقادیر واقعی را در local.properties قرار دهید
# و یا از طریق Settings > AI Provider در اپ وارد کنید.

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# OpenCode (اگر استفاده می‌کنید)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/api/v1

# Weather Provider
WEATHER_API_KEY=

# Search Provider
SEARCH_API_KEY=